{
  "name": "mystudy",
  "private": true,
  "version": "4.0.6",
  "description": "AI-Powered Course Learning Platform",
  "author": "noor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sidshot/upsc-study-desk.git"
  },
  "keywords": [
    "course-management",
    "video-player",
    "ai-transcription",
    "learning-platform",
    "offline-first",
    "react",
    "vite"
  ],
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "start:prod": "cross-env NODE_ENV=production node server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "pack:win": "electron-builder --win",
    "build:electron": "npm run build && npm run pack:win",
    "publish:win": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@xenova/transformers": "^2.0.1",
    "big-integer": "^1.6.52",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^5.1.0",
    "multer": "^2.1.1",
    "sql.js": "^1.12.0",
    "telegram": "^2.26.22",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "hls.js": "^1.6.15",
    "jimp": "^1.6.1",
    "lucide-react": "^0.469.0",
    "mpegts.js": "^1.8.0",
    "playwright": "^1.61.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "tailwindcss": "^3.4.17",
    "terser": "^5.44.1",
    "vite": "^6.0.5"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.omni.app",
    "productName": "Omni",
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Sidshot",
        "repo": "upsc-study-desk"
      }
    ],
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "icon": "public/omni.ico",
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "python/**/*",
      "public/**/*",
      "package.json",
      "!node_modules/onnxruntime-web/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**/*",
      "!node_modules/bufferutil/prebuilds/darwin-arm64/**/*",
      "!node_modules/bufferutil/prebuilds/darwin-x64/**/*",
      "!node_modules/bufferutil/prebuilds/linux-x64/**/*",
      "!node_modules/bufferutil/prebuilds/win32-ia32/**/*",
      "!node_modules/utf-8-validate/prebuilds/darwin-x64+arm64/**/*",
      "!node_modules/utf-8-validate/prebuilds/linux-x64/**/*",
      "!node_modules/utf-8-validate/prebuilds/win32-ia32/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/vite/**/*",
      "!node_modules/tailwindcss/**/*",
      "!node_modules/eslint/**/*",
      "!node_modules/postcss/**/*",
      "!node_modules/autoprefixer/**/*",
      "!node_modules/concurrently/**/*",
      "!node_modules/terser/**/*",
      "!node_modules/jimp/**/*"
    ],
    "asarUnpack": [
      "dist/**/*",
      "server/**/*",
      "python/**/*",
      "public/**/*"
    ]
  }
}
